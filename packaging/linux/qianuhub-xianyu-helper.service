[Unit]
Description=QianuHub Xianyu Helper
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qianuhub-xianyu
Group=qianuhub-xianyu
WorkingDirectory=/var/lib/qianuhub-xianyu-helper
EnvironmentFile=-/etc/qianuhub-xianyu-helper/config.env
Environment=XIANYU_LOG_DIR=/var/log/qianuhub-xianyu-helper
ExecStart=/opt/qianuhub-xianyu-helper/xianyu-server -addr 127.0.0.1:59188 -workdir /var/lib/qianuhub-xianyu-helper -data-key-file /var/lib/qianuhub-xianyu-helper/data-key -playwright-runtime-root /opt/qianuhub-xianyu-helper/playwright-runtime
Restart=on-failure
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
